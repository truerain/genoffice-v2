{
  "name": "@gen-office/gen-frame",
  "version": "0.2.0",
  "description": "GenOffice V2 app frame — layout chrome, navigation orchestration, URL sync",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./index.css": "./dist/index.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "clean": "rm -rf dist",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "storybook": "pnpm -C ../../apps/storybook dev",
    "build-storybook": "pnpm -C ../../apps/storybook build"
  },
  "dependencies": {
    "@gen-office/mdi": "workspace:*",
    "@gen-office/theme": "workspace:*",
    "@gen-office/ui": "workspace:*",
    "clsx": "^2.1.1",
    "lucide-react": "^0.562.0"
  },
  "devDependencies": {
    "@storybook/react": "10.4.6",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "22.15.32",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "jsdom": "29.1.1",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "typescript": "5.9.3",
    "vite": "6.4.3",
    "vite-plugin-dts": "5.0.2",
    "vitest": "4.1.9"
  },
  "peerDependencies": {
    "@gen-office/mdi": "workspace:*",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "@gen-office/mdi": {
      "optional": true
    }
  },
  "keywords": ["gen-office", "frame", "layout", "navigation"],
  "license": "ISC"
}
