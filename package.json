{
  "name": "gen-office",
  "private": true,
  "description": "Gen-Office V2 - Backoffice framework",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --filter=@gen-office/demo",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "storybook": "turbo run --filter=@gen-office/storybook dev"
  },
  "devDependencies": {
    "turbo": "latest",
    "nx": "latest",
    "prettier": "^3.4.2",
    "typescript": "5.9.3",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "eslint": "^9.0.0"
  },
  "packageManager": "pnpm@9.15.0",
  "pnpm": {
    "overrides": {
      "react": "19.2.7",
      "react-dom": "19.2.7",
      "@types/react": "19.2.17",
      "@types/react-dom": "19.2.3",
      "typescript": "5.9.3",
      "vite": "6.4.3",
      "@vitejs/plugin-react": "6.0.2",
      "storybook": "10.4.6",
      "@storybook/react": "10.4.6",
      "@storybook/react-vite": "10.4.6",
      "@storybook/addon-a11y": "10.4.6",
      "@storybook/addon-docs": "10.4.6",
      "@storybook/addon-links": "10.4.6",
      "@storybook/addon-vitest": "10.4.6",
      "vitest": "4.1.9",
      "jsdom": "29.1.1",
      "vite-plugin-dts": "5.0.2",
      "@testing-library/jest-dom": "6.9.1",
      "@testing-library/react": "16.3.2",
      "@testing-library/user-event": "14.6.1",
      "lodash": "4.18.1",
      "exceljs>tmp": "0.2.7"
    },
    "peerDependencyRules": {
      "allowAny": [],
      "ignoreMissing": [
        "react",
        "react-dom"
      ]
    }
  },
  "author": "James Shin",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  }
}
